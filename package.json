{
  "name": "qspec-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craftegy-Analytics/QSpec.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node scripts/copy-schemas.mjs",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-check.mjs",
    "release:dry-run": "node scripts/release-check.mjs --require-dist && node scripts/publish-packages.mjs --dry-run"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.0",
    "prettier": "3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
