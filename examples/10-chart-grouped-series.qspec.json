{
  "apiVersion": "qspec.dev/v1",
  "kind": "Chart",
  "metadata": {
    "name": "revenue-by-region",
    "title": "Revenue by Region",
    "description": "One line per region, derived at render time by partitioning rows on groupBy instead of naming each series explicitly",
    "tags": ["finance", "sales"]
  },
  "spec": {
    "parameters": {
      "from": { "type": "date", "required": true },
      "to": { "type": "date", "required": true }
    },
    "query": {
      "source": "analytics",
      "language": "sql",
      "statement": "SELECT date_trunc('month', created_at) AS month, region, SUM(amount) AS revenue FROM orders WHERE created_at >= :from AND created_at < :to GROUP BY month, region ORDER BY month",
      "bindings": {
        "from": "$parameters.from",
        "to": "$parameters.to"
      }
    },
    "dataset": {
      "fields": {
        "month": { "type": "datetime", "nullable": false },
        "region": { "type": "string", "nullable": false },
        "revenue": { "type": "number", "nullable": false, "semanticType": "currency" }
      }
    },
    "presentation": {
      "type": "line",
      "x": { "field": "month", "label": "Month" },
      "series": {
        "field": "revenue",
        "groupBy": "region",
        "label": "Revenue"
      },
      "legend": { "visible": true },
      "tooltip": { "visible": true }
    }
  }
}
